{
  "name": "blast-js-stress-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && npm run demo && npm run demo:ext && npm run demo:ext-cube && npm run demo:ext-bridge",
    "build": "node ./scripts/build.js",
    "build:ts": "npx -y tsc || true",
    "build:demo:wall": "esbuild wall-demolition.ts --outfile=dist/wall-demolition.js --format=esm",
    "build:demo:tower": "esbuild tower-collapse.ts --outfile=dist/tower-collapse.js --format=esm",
    "build:demo:fractured-wall": "esbuild fractured-wall.ts --outfile=dist/fractured-wall.js --format=esm",
    "build:demo:fractured-tower": "esbuild fractured-tower.ts --outfile=dist/fractured-tower.js --format=esm",
    "build:demo:fractured-bridge": "esbuild fractured-bridge.ts --outfile=dist/fractured-bridge.js --format=esm",
    "build:demo:fracture-policy": "esbuild fracture-policy.ts --outfile=dist/fracture-policy.js --format=esm",
    "build:demo:high-rise": "esbuild high-rise.ts --outfile=dist/high-rise.js --format=esm",
    "build:demo:house": "esbuild house.ts --outfile=dist/house.js --format=esm",
    "build:demo:centrifugal-spinner": "esbuild centrifugal-spinner.ts --outfile=dist/centrifugal-spinner.js --format=esm",
    "build:demo:cracking": "esbuild cracking.ts --outfile=dist/cracking.js --format=esm",
    "build:demo:mini-city": "esbuild mini-city.ts --outfile=dist/mini-city.js --format=esm",
    "build:demo:destructible-structures": "esbuild destructible-structures.ts --outfile=dist/destructible-structures.js --format=esm",
    "build:demo:session-viewer": "esbuild session-viewer.ts --outfile=dist/session-viewer.js --format=esm",
    "build:demo:split-planner": "esbuild split-planner-bench.ts --bundle --outfile=dist/split-planner-bench.js --format=esm",
    "build:demo:pipeline-controls": "esbuild pipeline-controls.ts --outfile=dist/pipeline-controls.js --format=esm",
    "build:demo:physics-controls": "esbuild physics-controls.ts --outfile=dist/physics-controls.js --format=esm",
    "build:demo:shooter-fps": "esbuild shooter-fps.ts --outfile=dist/shooter-fps.js --format=esm",
    "build:demo:vehicle-drive": "esbuild vehicle-drive.ts --outfile=dist/vehicle-drive.js --format=esm",
    "build:demo:glb-vehicle": "esbuild glb-vehicle.ts --outfile=dist/glb-vehicle.js --format=esm",
    "build:demo:destructible-vehicle": "esbuild destructible-vehicle.ts --outfile=dist/destructible-vehicle.js --format=esm",
    "build:demo:shell": "esbuild demo-shell.ts --outfile=dist/demo-shell.js --format=esm",
    "build:web": "npm run build:ts && npm run build:demo:shell && npm run build:demo:pipeline-controls && npm run build:demo:physics-controls && npm run build:demo:shooter-fps && npm run build:demo:vehicle-drive && npm run build:demo:glb-vehicle && npm run build:demo:destructible-vehicle && npm run build:demo:wall && npm run build:demo:tower && npm run build:demo:fractured-wall && npm run build:demo:fractured-tower && npm run build:demo:fractured-bridge && npm run build:demo:fracture-policy && npm run build:demo:high-rise && npm run build:demo:house && npm run build:demo:cracking && npm run build:demo:mini-city && npm run build:demo:destructible-structures && npm run build:demo:centrifugal-spinner && npm run build:demo:session-viewer && npm run build:demo:split-planner",
    "build:debug": "EMCC_PROFILING=1 EMCC_ASSERTIONS=1 node ./scripts/build.js",
    "demo": "npm run build --silent && node ./demo.js",
    "demo:ext": "npm run build --silent && node ./ext-demo.js",
    "demo:ext-cube": "npm run build --silent && node ./ext-cube-projectile.js",
    "demo:ext-bridge": "npm run build --silent && node ./ext-bridge-cars.js",
    "serve": "node scripts/serve.js",
    "test:bridge-ui": "npx playwright test tests/stress.spec.js",
    "test:bridge-ui:headed": "npx playwright test tests/stress.spec.js --headed --project=chromium",
    "test:bridge-ui:ui": "npx playwright test tests/stress.spec.js --ui",
    "test:split": "vitest run bridge/manualSplit.spec.ts bridge/eventfulReplay.spec.ts bridge/handleSplitEvents.spec.ts bridge/handleSplitEvents.multiple.spec.ts bridge/handleSplitEvents.bridgeScenario.spec.ts bridge/handleSplitEvents.extStress.spec.ts bridge/organicSplit.spec.ts",
    "test:split:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
